# Скопируйте в .env (cp .env.example .env) и при необходимости поменяйте значения.
# Файл .env в git НЕ коммитится.

POSTGRES_PASSWORD=change-me-local
# Любая длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-0123456789

# Необязательные (есть значения по умолчанию)
# SEED_PASSWORD=demo12345
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
